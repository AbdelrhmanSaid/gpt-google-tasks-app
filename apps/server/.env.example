# Copy to apps/server/.env; keep all actual secrets out of Git and chat.
# Google mode supports local testing only in this release.

TASKS_MODE=google
PORT=3001
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verified Google email addresses admitted to the private pilot.
# An empty list is a configuration error; it does not allow everyone.
PILOT_ALLOWED_EMAILS=

# Path relative to apps/server, kept outside compiled output.
AUTH_DATABASE_PATH=./data/auth.sqlite
