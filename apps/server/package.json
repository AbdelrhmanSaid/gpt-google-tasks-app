{
  "name": "@tasks/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "tsx src/auth/migrate.ts",
    "test:google": "node --test scripts/google.test.mjs",
    "oauth:register": "tsx src/auth/registerClient.ts",
    "test:oauth": "node --test scripts/oauth.test.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tasks/shared": "0.1.0",
    "better-auth": "^1.7.3",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.13"
  }
}
